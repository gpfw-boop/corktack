{
  "name": "corktack",
  "version": "0.1.0",
  "description": "Pinned comments for live web prototypes.",
  "license": "MIT",
  "author": "gpfw-boop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpfw-boop/corktack.git"
  },
  "homepage": "https://github.com/gpfw-boop/corktack#readme",
  "bugs": {
    "url": "https://github.com/gpfw-boop/corktack/issues"
  },
  "type": "module",
  "main": "./dist/corktack.umd.cjs",
  "module": "./dist/corktack.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/corktack.js",
      "require": "./dist/corktack.umd.cjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/size.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "e2e": "node scripts/e2e-realtime.mjs"
  },
  "keywords": [
    "feedback",
    "comments",
    "annotations",
    "prototype",
    "design review",
    "supabase"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^25.0.1",
    "lit": "^3.3.3",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
